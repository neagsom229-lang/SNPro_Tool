FLASK_SECRET_KEY=change-me-to-a-random-secret
# Leave DATABASE_URL unset/blank to auto-use an absolute path to
# <project>/instance/snpro.db (recommended, especially on Windows).
# Only set this if you're pointing at Postgres/MySQL instead.
DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STORAGE_ROOT=storage
MAX_CONTENT_LENGTH_MB=500

# Set to 1/true once you're serving over real HTTPS (behind Nginx/Caddy,
# or any host with a TLS cert). Keep it off for local http dev — a
# browser silently drops "Secure" cookies over plain http, which would
# make login look broken.
FORCE_HTTPS=

# Only needed for the optional Caddy reverse-proxy service in
# docker-compose.yml (the `--profile https` one) — your domain name,
# e.g. snpro.example.com. DNS for it must already point at this
# server's public IP before Caddy can get a certificate for it.
DOMAIN=

# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Required for translation (at least one)
GOOGLE_TRANSLATE_API_KEY=your_google_api_key_here
# OR
DEEPL_API_KEY=your_deepl_api_key_here

# Optional but recommended for best voice quality
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Optional, change as needed

# VibeVoice model directories
VIBEVOICE_ASR_MODEL_DIR=models/vibevoice-asr
VIBEVOICE_REALTIME_MODEL_DIR=models/vibevoice-realtime-0.5b
